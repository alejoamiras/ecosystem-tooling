{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "composite": false,
    "declarationMap": false,
    "inlineSourceMap": false
  },
  "include": [
    "src/ts/index.ts",
    "src/ts/config/**/*",
    "src/ts/client/**/*",
    "src/ts/operator/**/*",
    "src/ts/cli/**/*",
    "src/artifacts/QuotaFpc.ts",
    "target/quota_fpc-QuotaFpc.json",
    "known-deployments.json"
  ],
  "exclude": ["node_modules", "src/ts/test"]
}
