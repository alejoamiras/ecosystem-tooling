{
  "name": "@alejoamiras/quota-paymaster",
  "version": "6.0.0-rc.1",
  "description": "Quota paymaster (QuotaFpc) for Aztec — allowlist-scoped, per-day-quota fee sponsorship. Noir contract + TypeScript SDK + operator library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejoamiras/ecosystem-tooling.git",
    "directory": "packages/quota-paymaster"
  },
  "license": "MIT",
  "author": "Alejo Amiras",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/ts/index.js",
      "types": "./dist/src/ts/index.d.ts"
    },
    "./artifacts/quota-fpc": {
      "import": "./dist/src/artifacts/QuotaFpc.js",
      "types": "./dist/src/artifacts/QuotaFpc.d.ts"
    },
    "./operator": {
      "import": "./dist/src/ts/operator/index.js",
      "types": "./dist/src/ts/operator/index.d.ts"
    },
    "./operator/config": {
      "import": "./dist/src/ts/operator/config.js",
      "types": "./dist/src/ts/operator/config.d.ts"
    },
    "./known-deployments.json": "./known-deployments.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/src/ts/index.js",
  "types": "./dist/src/ts/index.d.ts",
  "bin": {
    "quota-paymaster": "bin/quota-paymaster.mjs"
  },
  "files": [
    "INTEGRATING.md",
    "bin",
    "dist",
    "target",
    "!target/*.json.bak",
    "known-deployments.json"
  ],
  "scripts": {
    "build": "bun run compile && bun run codegen && bunx tsc --project tsconfig.build.json",
    "ccc": "bun run clean && bun run compile && bun run codegen",
    "clean": "rm -rf ./src/artifacts/* ./target ./dist codegenCache.json",
    "codegen": "aztec codegen target --outdir src/artifacts -f",
    "compile": "aztec compile",
    "test": "bun run test:nr && bun run test:js",
    "test:js": "vitest run",
    "test:nr": "aztec test",
    "test:unit": "vitest run src/ts/test/unit examples",
    "test:warp": "vitest run --config vitest.warp.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:lineage": "bun scripts/verify-lineage.ts",
    "verify:package": "bun run verify:lineage && bun ../../scripts/verify-tarball.ts ."
  },
  "devDependencies": {
    "@aztec-foundation/l1-artifacts": "6.0.0-rc.1",
    "@aztec-labs/accounts": "6.0.0-rc.1",
    "@aztec-labs/aztec.js": "6.0.0-rc.1",
    "@aztec-labs/constants": "6.0.0-rc.1",
    "@aztec-labs/entrypoints": "6.0.0-rc.1",
    "@aztec-labs/ethereum": "6.0.0-rc.1",
    "@aztec-labs/foundation": "6.0.0-rc.1",
    "@aztec-labs/protocol-contracts": "6.0.0-rc.1",
    "@aztec-labs/stdlib": "6.0.0-rc.1",
    "@aztec-labs/wallets": "6.0.0-rc.1",
    "@noble/hashes": "1.8.0",
    "@types/node": "25.6.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@aztec-foundation/l1-artifacts": "6.0.0-rc.1",
    "@aztec-labs/accounts": "6.0.0-rc.1",
    "@aztec-labs/aztec.js": "6.0.0-rc.1",
    "@aztec-labs/entrypoints": "6.0.0-rc.1",
    "@aztec-labs/ethereum": "6.0.0-rc.1",
    "@aztec-labs/foundation": "6.0.0-rc.1",
    "@aztec-labs/stdlib": "6.0.0-rc.1",
    "@aztec-labs/wallets": "6.0.0-rc.1",
    "tsx": "^4.19.0"
  },
  "peerDependenciesMeta": {
    "@aztec-labs/wallets": {
      "optional": true
    },
    "tsx": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
